# /client/.env.example
# Basisadresse, die in QR-Codes geschrieben wird.
# Wichtig: Für Smartphone-Scans NICHT localhost verwenden.
#
# Beispiele:
# Mac-Test im Heimnetz:     http://192.168.176.82:5174
# Raspberry Pi später:      http://192.168.176.89:5174
#
# Für deine lokale Installation den passenden Wert nach client/.env.local kopieren.
VITE_APP_BASE_URL=http://192.168.xxx.xxx:5174